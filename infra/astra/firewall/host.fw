[RULES]

IN REJECT -source 192.168.1.201 -p tcp -dport 22 -log nolog # No SSH from Pulsar, read before the built-in management rules
IN ACCEPT -source +management -p tcp -dport 3493 -log nolog # NUT (upsd, read by PeaNUT on Pulsar)
IN Ping(ACCEPT) -source +management -log nolog # Ping from LAN and VPN
