[Unit]
Description=Dump the live databases of Pulsar for off-site backup
Documentation=https://github.com/Enoal-Fauchille-Bolle/Astra-ops/blob/main/docs/backup/README.md
After=k3s.service docker.service

[Service]
Type=oneshot
# PUSH_URL=<Uptime Kuma push URL>, root-only, never committed. Optional: without it the
# script runs but reports nothing, and the push monitor raises the alert.
EnvironmentFile=-/etc/default/dump-databases
ExecStart=/usr/local/sbin/dump-databases
Nice=10
# Well past the ~10 s a run takes, and short of Zerobyte job 13 at 02:00
TimeoutStartSec=50min
